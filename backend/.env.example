NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/hookrelay
REDIS_URL=redis://127.0.0.1:6379
REDIS_STREAM=hookrelay:events
REDIS_STREAM_GROUP=hookrelay-delivery-workers
REDIS_OBSERVABILITY_CHANNEL=hookrelay:delivery-events
WORKER_CONSUMER_NAME=worker-1
DELIVERY_TIMEOUT_MS=5000
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=300000
RETRY_JITTER_MS=1000
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_FAILURE_WINDOW_MS=60000
CIRCUIT_BASE_COOLDOWN_MS=45000
CIRCUIT_MAX_COOLDOWN_MS=300000
CIRCUIT_PROBE_LEASE_MS=7000
RATE_LIMIT_DEFAULT_RPS=50
RATE_LIMIT_DEFAULT_BURST=10
